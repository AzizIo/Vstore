APP_NAME=VILTARA SHOP API
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://viltara:viltara@localhost:5432/viltara
REDIS_URL=redis://localhost:6379/0
BOT_TOKEN=
# Telegram Mini App direct link configured through @BotFather (not the frontend website URL).
# Format: https://t.me/<bot_username>/<app_short_name>; leave empty until configured.
TELEGRAM_MINI_APP_URL=
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=3600
# Exact Mini App hostname, without scheme/path, as a JSON array; leave empty until the real public host is configured.
TON_CONNECT_ALLOWED_DOMAINS=[]
TON_CONNECT_NETWORK=mainnet
# Public frontend configuration (not secrets); dev Compose passes these to Vite at runtime, while the static preview uses them as build args.
VITE_TONCONNECT_APP_URL=
VITE_TONCONNECT_MANIFEST_URL=
TON_CENTER_API_KEY=
TON_CENTER_MAINNET_BASE_URL=https://toncenter.com/api/v3
TON_CENTER_TESTNET_BASE_URL=https://testnet.toncenter.com/api/v3
TON_CENTER_TIMEOUT_SECONDS=8
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional isolated static preview stack (docker-compose.preview.yml).
# Generate a fresh URL-safe value with: openssl rand -hex 32
PREVIEW_DB_PASSWORD=
PREVIEW_HTTP_PORT=8080

# Isolated preview TON settings: do not change the existing development stack's TON network/domain.
# The preview API requires an exact public HTTPS hostname and defaults to testnet.
PREVIEW_TON_CONNECT_ALLOWED_DOMAINS=[]
PREVIEW_TON_CONNECT_NETWORK=testnet
