APP_NAME=VILTARA SHOP API
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://viltara:viltara@localhost:5432/viltara
REDIS_URL=redis://localhost:6379/0
BOT_TOKEN=
# Public HTTPS Mini App URL used by the bot's inline Web App launch button.
TELEGRAM_MINI_APP_URL=
# Optional Telegram direct link used for order notification startapp deep links.
# Format: https://t.me/<bot_username>/<app_short_name>.
TELEGRAM_MINI_APP_DIRECT_LINK=
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=3600
# JSON array of numeric Telegram user IDs allowed to use /admin; empty disables admin access.
ADMIN_TELEGRAM_IDS=[]
# Exact Mini App hostname, without scheme/path, as a JSON array; leave empty until the real public host is configured.
TON_CONNECT_ALLOWED_DOMAINS=[]
TON_CONNECT_NETWORK=mainnet
# Public frontend configuration (not secrets); dev Compose passes these to Vite at runtime, while the static preview uses them as build args.
VITE_TONCONNECT_APP_URL=
VITE_TONCONNECT_MANIFEST_URL=
TON_CENTER_API_KEY=
TON_CENTER_MAINNET_BASE_URL=https://toncenter.com/api/v3
TON_CENTER_TESTNET_BASE_URL=https://testnet.toncenter.com/api/v3
TON_CENTER_TIMEOUT_SECONDS=8
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Isolated static preview stack (docker-compose.preview.yml).
# Generate a fresh URL-safe value with: openssl rand -hex 32
PREVIEW_AUTH_SECRET_KEY=
PREVIEW_BOT_TOKEN=
PREVIEW_DB_PASSWORD=
PREVIEW_HTTP_PORT=8080
PREVIEW_TELEGRAM_MINI_APP_URL=
PREVIEW_TELEGRAM_MINI_APP_DIRECT_LINK=

# Preview-only frontend and wallet config. Do not change the existing dev stack values above.
PREVIEW_VITE_TONCONNECT_APP_URL=
PREVIEW_VITE_TONCONNECT_MANIFEST_URL=
PREVIEW_TON_CONNECT_ALLOWED_DOMAINS=[]
# Exact HTTPS origin in a JSON array; must match PREVIEW_VITE_TONCONNECT_APP_URL.
PREVIEW_CORS_ALLOWED_ORIGINS=[]
PREVIEW_TON_CONNECT_NETWORK=testnet
PREVIEW_TON_CENTER_API_KEY=
PREVIEW_TON_CENTER_MAINNET_BASE_URL=https://toncenter.com/api/v3
PREVIEW_TON_CENTER_TESTNET_BASE_URL=https://testnet.toncenter.com/api/v3
