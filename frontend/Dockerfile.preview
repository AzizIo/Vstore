FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --global npm@12.2.2 && npm ci

COPY . .

ARG VITE_TONCONNECT_APP_URL
ARG VITE_TONCONNECT_MANIFEST_URL
ARG VITE_ESCROW_TESTNET_ENABLED=false
ENV VITE_TONCONNECT_APP_URL=${VITE_TONCONNECT_APP_URL}
ENV VITE_TONCONNECT_MANIFEST_URL=${VITE_TONCONNECT_MANIFEST_URL}
ENV VITE_ESCROW_TESTNET_ENABLED=${VITE_ESCROW_TESTNET_ENABLED}
ARG VITE_TELEGRAM_MINI_APP_DIRECT_LINK
ENV VITE_TELEGRAM_MINI_APP_DIRECT_LINK=${VITE_TELEGRAM_MINI_APP_DIRECT_LINK}

RUN npm run build

FROM nginx:alpine

COPY nginx.preview.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
