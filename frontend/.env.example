# Public HTTPS origin where VILTARA SHOP is served. Replace with the real deployed Mini App URL.
# Used to generate tonconnect-manifest.json and its absolute icon URL.
VITE_TONCONNECT_APP_URL=https://your-miniapp-domain.example
# Must be HTTPS and on the same origin as VITE_TONCONNECT_APP_URL.
VITE_TONCONNECT_MANIFEST_URL=https://your-miniapp-domain.example/tonconnect-manifest.json
