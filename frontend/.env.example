# Development setup:
#   cp frontend/.env.example frontend/.env
# Docker Compose bind-mounts ./frontend into /app, so Vite reads frontend/.env.
# Do not put secrets in these VITE_ values; they are public and embedded in the frontend.
# Public HTTPS origin where VILTARA SHOP is served. Set the actual deployed Mini App URL.
# The production build intentionally fails until both values are configured.
VITE_TONCONNECT_APP_URL=
# Must be HTTPS and on the same origin, with the fixed /tonconnect-manifest.json path.
VITE_TONCONNECT_MANIFEST_URL=
