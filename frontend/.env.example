# Optional standalone Vite setup (when running outside Docker Compose).
# With Docker Compose, put these public URLs in the repository root .env instead;
# docker-compose.yml passes them into the miniapp container.
# Do not put secrets in VITE_ values: they are embedded in the frontend bundle.
# The production build intentionally fails until both values are configured.
VITE_TONCONNECT_APP_URL=
# Must be HTTPS and on the same origin, with the fixed /tonconnect-manifest.json path.
VITE_TONCONNECT_MANIFEST_URL=
