modules:
  http_2xx_no_redirect:
    prober: http
    timeout: 5s
    http:
      method: GET
      follow_redirects: false
      valid_status_codes: [200, 204]
      preferred_ip_protocol: ip4
  https_2xx:
    prober: http
    timeout: 5s
    http:
      method: GET
      follow_redirects: false
      valid_status_codes: [200, 204]
      preferred_ip_protocol: ip4
      tls_config:
        insecure_skip_verify: false
